# =============================================================================
# VoiceGuard AI — Production Environment Template
# Phase 32: Production Infrastructure (SIH26104)
#
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.production.template .env.production
#   2. Fill ALL values marked CHANGE_ME
#   3. NEVER commit .env.production to git
#   4. Restrict file permissions: chmod 600 .env.production
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=WARNING

# ── Domain ────────────────────────────────────────────────────────────────────
# Your production domain (no https://, no trailing slash)
DOMAIN=voiceguard.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# Frontend URL for CORS (comma-separated if multiple origins)
ALLOWED_ORIGINS=https://voiceguard.yourdomain.com,https://admin.voiceguard.yourdomain.com

# ── Images (from GHCR — use immutable digests in production) ──────────────────
# Get digest from: docker manifest inspect ghcr.io/<org>/voiceguard-backend:latest
# Format: ghcr.io/<org>/voiceguard-backend@sha256:<64hex>
BACKEND_IMAGE=ghcr.io/CHANGE_ME/voiceguard-backend@sha256:CHANGE_ME
FRONTEND_IMAGE=ghcr.io/CHANGE_ME/voiceguard-frontend@sha256:CHANGE_ME

# ── Secret Key ────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Must be >= 32 hex chars. Weak values REJECTED at startup.
SECRET_KEY=CHANGE_ME_RUN_python_secrets_token_hex_32

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=voiceguard_prod
DB_USER=voiceguard
# Generate: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

# Host bind paths for Docker volumes (create these on the server first)
POSTGRES_DATA_PATH=/opt/voiceguard/data/postgres
POSTGRES_BACKUP_PATH=/opt/voiceguard/backups/postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_MAXMEMORY=512mb
REDIS_DATA_PATH=/opt/voiceguard/data/redis

# ── Storage Paths ─────────────────────────────────────────────────────────────
MODEL_CACHE_PATH=/opt/voiceguard/models
AUDIO_STORAGE_PATH=/opt/voiceguard/audio

# ── JWT ───────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Uvicorn Tuning (Phase 28) ─────────────────────────────────────────────────
# Workers = 2 × CPU cores (capped at 8 for memory safety)
UVICORN_WORKERS=4
BACKEND_REPLICAS=2

# Phase 28 performance settings
CACHE_MAX_SIZE=5000
CACHE_DEFAULT_TTL=300
INFERENCE_POOL_SIZE=4
RING_BUFFER_CAPACITY_SECONDS=10

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
# Generate: openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GRAFANA_SECRET_KEY=CHANGE_ME_GRAFANA_SECRET_KEY

PROMETHEUS_RETENTION=30d
PROMETHEUS_DATA_PATH=/opt/voiceguard/data/prometheus
GRAFANA_DATA_PATH=/opt/voiceguard/data/grafana

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30

# ── OpenTelemetry (optional) ──────────────────────────────────────────────────
# OTEL_ENDPOINT=http://otel-collector:4318

# ── Email (optional) ──────────────────────────────────────────────────────────
# SMTP_HOST=smtp.yourdomain.com
# SMTP_USER=voiceguard-noreply@yourdomain.com
# SMTP_PASSWORD=CHANGE_ME
# SMTP_FROM=VoiceGuard <voiceguard-noreply@yourdomain.com>
# GF_SMTP_ENABLED=true

