# =============================================================================
# VoiceGuard AI — Environment Configuration Template
# Phase 25: Security & Privacy Hardening
# =============================================================================
# Copy this file to .env and fill in ALL values before deployment.
# NEVER commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_ENV=production
# Valid values: development | production
# In production, weak SECRET_KEY values are rejected at startup.

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# -----------------------------------------------------------------------------
# SECRET KEY
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be >= 32 hex chars in production. Default value is REJECTED in production.
# -----------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_USE_SECRETS_TOKEN_HEX_32

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Development default (SQLite — do NOT use in production)
DATABASE_URL=sqlite:///./voiceguard.db

# Production (PostgreSQL with Row-Level Security)
# DATABASE_URL=postgresql+psycopg2://voiceguard_user:STRONG_PASSWORD@db-host:5432/voiceguard_prod

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
# Used for distributed rate limiting, session cache, pub/sub
REDIS_URL=redis://localhost:6379/0
# Production (with TLS):
# REDIS_URL=rediss://:AUTH_TOKEN@redis-host:6380/0

# -----------------------------------------------------------------------------
# CORS / ALLOWED ORIGINS
# Comma-separated list of trusted origins for CORS.
# In development, localhost origins are included by default.
# In production, set ONLY your deployed frontend domain(s).
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=https://voiceguard.yourdomain.com,https://admin.voiceguard.yourdomain.com

# -----------------------------------------------------------------------------
# JWT / AUTH
# -----------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# -----------------------------------------------------------------------------
# AI / MODEL SERVICES (stub; configure when enabling real inference)
# -----------------------------------------------------------------------------
VOICEGUARD_MODEL_ENDPOINT=http://localhost:9000
VOICEGUARD_MODEL_API_KEY=CHANGE_ME

# Voice cloning detection model
VOICE_MODEL_NAME=VoiceGuard-Conformer-v2.4
VOICE_MODEL_VERSION=2.4.1

# Speaker verification model
SPEAKER_MODEL_NAME=VoiceGuard-Speaker-v1.2

# -----------------------------------------------------------------------------
# AUDIO INGESTION LIMITS
# -----------------------------------------------------------------------------
MAX_AUDIO_FILE_SIZE_MB=25
MAX_AUDIO_CHUNK_SIZE_KB=1024

# -----------------------------------------------------------------------------
# NOTIFICATION SERVICES (configure as needed)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=voiceguard-noreply@yourdomain.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=VoiceGuard Security <voiceguard-noreply@yourdomain.com>

# Twilio (optional — for SMS/voice OTP)
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Push Notification (Firebase Cloud Messaging)
FCM_SERVER_KEY=CHANGE_ME

# -----------------------------------------------------------------------------
# LOGGING & MONITORING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# Valid values: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Never use DEBUG in production (may leak sensitive data to logs)

SENTRY_DSN=
# Leave blank to disable Sentry error reporting

# -----------------------------------------------------------------------------
# DATA RETENTION (days; 0 = retain indefinitely)
# -----------------------------------------------------------------------------
AUDIO_RETENTION_DAYS=90
CALL_LOG_RETENTION_DAYS=365
ALERT_RETENTION_DAYS=730
INCIDENT_RETENTION_DAYS=1825
AUDIT_LOG_RETENTION_DAYS=2555

# -----------------------------------------------------------------------------
# SECURITY HARDENING FLAGS
# -----------------------------------------------------------------------------
ENFORCE_HTTPS=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict

# Password policy
MIN_PASSWORD_LENGTH=12
REQUIRE_PASSWORD_COMPLEXITY=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_SECONDS=300
