# VoiceGuard AI — Root .dockerignore
# Excludes development artifacts, caches, and unnecessary files from build context

# Version control
.git
.gitignore
.github

# Python & Virtual Environments
__pycache__
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
*.log

# Node & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/dist/
frontend/node_modules/

# Desktop & Mobile applications (not deployed in server container)
desktop/
mobile/

# Local databases and runtime state
*.db
*.sqlite3
*.db-journal

# Environment files with secrets
.env
.env.local
.env.*.local
.env.prod

# Operating system artifacts
.DS_Store
Thumbs.db
*.swp
*.swo

# Docker Compose overrides
docker-compose.override.yml

